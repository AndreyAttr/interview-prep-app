{
  // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
  "version": "0.2.0",
  "configurations": [
    {
      "name": "ng serve",
      "type": "chrome",
      "request": "launch",
      // "preLaunchTask": "npm: start",     //displays the "Waiting for preLaunchTask 'start'..." after first debug(second, third, ...) because tries to start dev server second time when it's already running after first debug.
      "url": "http://localhost:4200/"
    },
    {
      "name": "ng serve (attach to Chrome tab with remote debugging)",
      "type": "chrome",
      "request": "attach",
      "port": 9222,
      "url": "http://localhost:4200/"
    },
    {
      "name": "ng test",
      "type": "chrome",
      "request": "launch",
      "preLaunchTask": "npm: test",
      "url": "http://localhost:9876/debug.html"
    }
  ]
}
