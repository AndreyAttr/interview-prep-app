    {
      "label": "clean_logs",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/.playwright-mcp/clean_logs.ps1"
      ],
      "problemMatcher": []
    }
  ]
